# 占位配置，不含真实密钥；复制为 .env 并填写
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_MODEL=deepseek-flash

# 服务商端点与超时（默认值如下，通常无需修改）
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_TIMEOUT=30

# 项目网关访问凭证：客户端调用 /api/model/turn 时携带 Authorization: Bearer <GATEWAY_TOKEN>
# 独立于服务商密钥；客户端只有本项目凭证，没有服务商权限
GATEWAY_TOKEN=change-me

# 基本限流：每个凭证每分钟最多请求次数（单进程内存实现，仅用于演示部署）
RATE_LIMIT_PER_MINUTE=30
