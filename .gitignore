# 系统与编辑器临时文件
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# DevEco / Android Studio 本机工程状态
.idea/
*.iml
local.properties

# ArkUI-X、Hvigor、Node 和 Android 依赖与缓存
oh_modules/
node_modules/
.hvigor/
.gradle/
.cxx/
.externalNativeBuild/
xcuserdata/
*.xcuserstate
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 构建输出与安装包
/client/**/build/
/client/**/dist/
# ACE regenerates these assets, runtime libraries and machine-specific bridge scripts.
/client/.arkui-x/android/app/libs/
/client/.arkui-x/android/app/src/main/assets/arkui-x/
/client/.arkui-x/android/buildArkTS
/client/.arkui-x/android/buildArkTS.bat
/client/.arkui-x/ios/arkui-x/
/client/.arkui-x/ios/buildArkTS.sh
/server/build/
/server/dist/
*.egg-info/
*.hap
*.hsp
*.app
*.apk
*.aab
*.ipa

# Python 虚拟环境、字节码、检查与覆盖率缓存
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# 本机环境变量；保留不含真实密钥的配置示例
.env
.env.*
!.env.example
!.env.sample
!.env.template

# 本机签名材料与私密配置目录
*.p12
*.pfx
*.jks
*.keystore
*.p7b
/secrets/
/server/secrets/
/client/signing/

# 调试用运行数据与日志；应用正式数据应位于各端私有目录
/runtime/
/server/runtime/
/logs/
/server/logs/

# 保留共享工程源码和配置，包括 client/.arkui-x/ 内必要的平台工程。
# 保留依赖声明与锁文件，例如 oh-package-lock.json5、package-lock.json。
# 保留 Gradle wrapper、docs/、fixtures/ 和团队共用的 .vscode/ 配置。
# 不整体忽略 data/、domain/、JSON 或日志扩展名，避免隐藏源码和脱敏样例。
